# Web application (public Firebase web configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
NEXT_PUBLIC_LOCAL_APP_CHECK_TOKEN=
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8080

# Platform API (server-only; use Secret Manager outside local development)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
PLATFORM_DATABASE_URL=
SQWEB_ALLOWED_ORIGINS=http://localhost:3000
SQWEB_DEFAULT_INSTITUTION_ID=
SQWEB_APP_CHECK_MODE=firebase
SQWEB_LOCAL_APP_CHECK_TOKEN=
PORT=8080

# Provisioning worker (server-only)
WORKSPACE_ADMIN_DATABASE_URL=
WORKSPACE_DATABASE_HOST=
WORKSPACE_DATABASE_PORT=3306
WORKSPACE_POOL_INSTANCE_ID=
WORKSPACE_LOCAL_SECRET_DIRECTORY=
WORKSPACE_SECRET_STORE=google
GOOGLE_CLOUD_PROJECT=
WORKER_POLL_INTERVAL_MS=1000
WORKER_RUN_ONCE=false
