# Web application (public Firebase web configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
NEXT_PUBLIC_LOCAL_APP_CHECK_TOKEN=
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8080
NEXT_PUBLIC_EXECUTION_API_URL=http://localhost:8081
NEXT_PUBLIC_INTERACTIVE_RUN_API_URL=http://localhost:8084

# Platform API (server-only; use Secret Manager outside local development)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
PLATFORM_DATABASE_URL=
SQWEB_ALLOWED_ORIGINS=http://localhost:3000
SQWEB_DEFAULT_INSTITUTION_ID=
SQWEB_APP_CHECK_MODE=firebase
SQWEB_LOCAL_APP_CHECK_TOKEN=
SQWEB_EXECUTION_GRANT_SECRET=
INTERACTIVE_RUN_MAX_RUNTIME_SECONDS=300
PORT=8080

# Execution API (server-only; shares several vars above)
# Code Workspace judge (RapidAPI Judge0) — leave RAPIDAPI_JUDGE0_KEY unset to
# run the Code Workspace UI with execution disabled until a key is added.
RAPIDAPI_JUDGE0_KEY=
RAPIDAPI_JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Interactive Code Compiler runner (local Docker service)
CODE_RUNTIME_IMAGE_TAG=sqweb/code-runtime:local
INTERACTIVE_RUN_MEMORY_LIMIT_MB=512
INTERACTIVE_RUN_CPU_LIMIT=1000m
INTERACTIVE_RUN_ORPHAN_SWEEP_INTERVAL_MS=120000

# Provisioning worker (server-only)
WORKSPACE_ADMIN_DATABASE_URL=
WORKSPACE_DATABASE_HOST=
WORKSPACE_DATABASE_PORT=3306
WORKSPACE_POOL_INSTANCE_ID=
WORKSPACE_LOCAL_SECRET_DIRECTORY=
WORKSPACE_SECRET_STORE=google
GOOGLE_CLOUD_PROJECT=
WORKER_POLL_INTERVAL_MS=1000
WORKER_RUN_ONCE=false
