# Dependencies
node_modules/

# Next.js and build output
.next/
out/
dist/
coverage/

# Local environment and secrets
.env
.env.*
# Any *.example template (.env.example, .env.local.example,
# .env.prod.example, ...) is a placeholder file meant to be committed —
# only the broader .env.* pattern above was ever meant to catch real
# secrets.
!.env*.example
*.local
*.local.log
*.local.error.log

# Test artifacts
playwright-report/
test-results/

# Tool caches
*.tsbuildinfo
.turbo/
.eslintcache
firebase-debug.log
infrastructure/local/workspace-secrets/
infrastructure/vps/.env.prod
infrastructure/vps/firebase-service-account.json
infrastructure/vps/workspace-secrets/

# IDE and operating system
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Terraform local state must never be committed
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
