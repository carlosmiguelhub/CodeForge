# Copy to infrastructure/vps/.env.prod on the VPS and fill in real values.
# .env.prod is gitignored — never commit it. See DEPLOY.md for how to
# generate each secret and where each piece comes from.

# ---- MySQL ----
# Generate with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
PLATFORM_DB_APP_PASSWORD=
WORKSPACE_MYSQL_ROOT_PASSWORD=

# ---- Shared across services ----
NODE_ENV=production
# Same 32+ char secret used by platform-api, execution-api, and
# interactive-run-api to sign/verify short-lived execution grants —
# generate with: openssl rand -hex 32
SQWEB_EXECUTION_GRANT_SECRET=

# ---- platform-api ----
FIREBASE_PROJECT_ID=
# ⚠ .env files are NOT shell-interpolated when Compose injects them into a
# container — paste the exact same value you used for PLATFORM_DB_APP_PASSWORD
# above into this URL by hand, a ${PLATFORM_DB_APP_PASSWORD} reference here
# would reach the container as that literal, un-substituted text.
# User is sqweb_app (matches the mysql service's MYSQL_USER in
# docker-compose.prod.yml) — NOT root.
PLATFORM_DATABASE_URL=mysql://sqweb_app:<same-value-as-PLATFORM_DB_APP_PASSWORD>@mysql:3306/sqweb_platform
# Your Vercel deployment's real origin (no trailing slash), e.g.
# https://codeforge.vercel.app — comma-separate if you add a custom domain
# later.
SQWEB_ALLOWED_ORIGINS=
SQWEB_DEFAULT_INSTITUTION_ID=
INTERACTIVE_RUN_MAX_RUNTIME_SECONDS=300

# ---- execution-api & provisioning-worker (per-student workspace secrets) ----
# File-based, not Google Secret Manager — see [[sqweb-hosting-plan]] and
# [[sqweb-interactive-stdin-plan]] memory: no GCP billing account for this
# deployment, and the production guards against WORKSPACE_SECRET_STORE=local
# were deliberately removed after reviewing LocalWorkspaceSecretStore's
# implementation (0600 file perms, atomic writes, path-traversal-safe).
WORKSPACE_SECRET_STORE=local
# Matches both services' volume mount in docker-compose.prod.yml.
WORKSPACE_LOCAL_SECRET_DIRECTORY=/workspace-secrets

# ---- execution-api ----
RAPIDAPI_JUDGE0_KEY=
RAPIDAPI_JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ---- provisioning-worker ----
# Root/admin connection — provisioning-worker uses this to CREATE each new
# per-student database + user on workspace-mysql, then stores those new
# credentials via WORKSPACE_LOCAL_SECRET_DIRECTORY above. Same caveat as
# PLATFORM_DATABASE_URL above: paste the real WORKSPACE_MYSQL_ROOT_PASSWORD
# value in by hand, don't reference it with ${...}.
WORKSPACE_ADMIN_DATABASE_URL=mysql://root:<same-value-as-WORKSPACE_MYSQL_ROOT_PASSWORD>@workspace-mysql:3306
# The hostname/port baked into each *new* workspace credential this worker
# creates — must be reachable from execution-api's container, hence the
# compose service name, not localhost/127.0.0.1.
WORKSPACE_DATABASE_HOST=workspace-mysql
WORKSPACE_DATABASE_PORT=3306
# One arbitrary fixed UUID identifying this single-instance pool — must
# match whatever's in the workspace_pool_instances row this worker claims
# against (see packages/database-platform migrations / the pool-instance
# bootstrap step in DEPLOY.md).
WORKSPACE_POOL_INSTANCE_ID=

# ---- interactive-run-api ----
CODE_RUNTIME_IMAGE_TAG=sqweb/code-runtime:prod
INTERACTIVE_RUN_MEMORY_LIMIT_MB=512
INTERACTIVE_RUN_CPU_LIMIT=1000m
INTERACTIVE_RUN_ORPHAN_SWEEP_INTERVAL_MS=120000
# Sized for this 4GB box — see the comment on this var in the root
# .env.example before raising it.
INTERACTIVE_RUN_MAX_CONCURRENT=3
# The HOST's path to the ./interactive-run-tmp directory the compose file
# bind-mounts into this service — MUST be the absolute path where you
# actually cloned this repo, + infrastructure/vps/interactive-run-tmp.
# If you followed DEPLOY.md exactly (cloned to /root/CodeForge), this is:
INTERACTIVE_RUN_HOST_TMP_DIR=/root/CodeForge/infrastructure/vps/interactive-run-tmp
